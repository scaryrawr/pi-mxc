{
  "enabled": true,
  "backend": "auto",
  "shellPath": "/bin/bash",
  "timeoutMs": 120000,
  "filesystem": {
    "readonlyPaths": [
      "~/.gitconfig",
      "~/.config/git/config",
      "~/.config/git/ignore",
      "~/.config/git/attributes"
    ],
    "readwritePaths": ["."],
    "deniedPaths": ["~/.ssh", "~/.aws", "~/.gnupg", "~/.azure"]
  },
  "network": {
    "egress": "deny",
    "ingress": "deny",
    "hostLoopback": "deny"
  },
  "inheritHostPath": true,
  "environment": {}
}
